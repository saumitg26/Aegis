# Database and Storage
DATABASE_URL=sqlite:///./backend/data/aegis.db
ARTIFACT_DIR=./backend/data/artifacts

# Google Gemini API (Get key for free from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs Speech-to-Text & Text-to-Speech (Get key from: https://elevenlabs.io/)
ELEVENLABS_API_KEY=
# Voice ID (e.g. 21m00Tcm4TlvDq8ikWAM for Rachel, or find in ElevenLabs VoiceLab)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional local CORS origins (public demo requests must be same-origin)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Hosted interactive demo: isolated temporary guest workspaces, single worker only
# Leave false for the loopback-only local workflow. Docker/Render defaults to true.
PUBLIC_DEMO=false
